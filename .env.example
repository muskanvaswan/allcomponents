# Polishd (product analytics and design review at /polishd). Local development
# needs none of these; set them in Vercel for production. See README.md.

# Unlocks the dashboard in production. Make one with `openssl rand -hex 32`.
POLISHD_DASHBOARD_TOKEN=

# Pooled Postgres connection string where production events are stored.
# Without it, production captures nothing.
POLISHD_DATABASE_URL=
